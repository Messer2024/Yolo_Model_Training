/* YOLO Studio 现代化暗黑主题 (Dark Theme) */

QMainWindow, QWidget {
    background-color: #1e1e24;
    color: #e0e0e0;
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #2d2d38;
    background-color: #1e1e24;
    top: -1px;
}

QTabBar::tab {
    background-color: #262630;
    color: #9e9eaf;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #2d2d38;
    color: #00d4bb;
    border-bottom: 2px solid #00d4bb;
}

QTabBar::tab:hover:!selected {
    background-color: #323240;
    color: #ffffff;
}

/* 按钮设计 */
QPushButton {
    background-color: #2b2b36;
    color: #ffffff;
    border: 1px solid #3e3e4f;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #383848;
    border-color: #00d4bb;
}

QPushButton:pressed {
    background-color: #20202a;
}

QPushButton:disabled {
    background-color: #1a1a20;
    color: #606070;
    border-color: #282830;
}

/* 主操作强调按钮 (Primary Button) */
QPushButton#primaryButton {
    background-color: #00b49e;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #00d4bb;
}

QPushButton#primaryButton:pressed {
    background-color: #009985;
}

/* 危险/停止按钮 (Danger Button) */
QPushButton#dangerButton {
    background-color: #c93b3b;
    color: #ffffff;
    border: none;
}

QPushButton#dangerButton:hover {
    background-color: #e04545;
}

/* 输入框与下拉列表 */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #262632;
    color: #ffffff;
    border: 1px solid #3d3d4e;
    border-radius: 5px;
    padding: 6px 10px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #00d4bb;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #262632;
    color: #ffffff;
    selection-background-color: #00b49e;
    border: 1px solid #3d3d4e;
}

/* 列表与树状视图 */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #242430;
    border: 1px solid #323242;
    border-radius: 6px;
    padding: 4px;
    color: #e0e0e0;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #333345;
    color: #00d4bb;
    border-radius: 4px;
}

QListWidget::item:hover:!selected {
    background-color: #2a2a38;
}

/* 进度条 */
QProgressBar {
    border: 1px solid #353545;
    border-radius: 6px;
    text-align: center;
    background-color: #1a1a22;
    color: #ffffff;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00b49e, stop:1 #00e5ca);
    border-radius: 5px;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background-color: #1a1a22;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #3a3a4c;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00d4bb;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 分组框 */
QGroupBox {
    border: 1px solid #343444;
    border-radius: 8px;
    margin-top: 14px;
    font-weight: bold;
    color: #00d4bb;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
}

/* 滑块 */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #2e2e3e;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #00b49e;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #ffffff;
    border: 2px solid #00b49e;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px;
}
